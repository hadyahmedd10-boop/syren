# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://your-domain.com
ADMIN_EMAIL_ALLOWLIST=admin@example.com,manager@example.com
INDEXNOW_KEY=indexnow-demo-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PostHog (Optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Email (Brevo)
# IMPORTANT: no trailing spaces, newlines or CRLF in these values — an untrimmed
# sender address is rejected by the Brevo API. EMAIL_FROM must be on a domain
# authenticated (SPF + DKIM) for Brevo.
BREVO_API_KEY=xkeysib-...
NOTIFY_EMAIL=info@syrentravel.com
EMAIL_FROM=noreply@syrentravel.com

# Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Tools (Optional)
# Set to true ONLY for local development to enable Vercel tools
NEXT_PUBLIC_ENABLE_VERCEL_LIVE=false
